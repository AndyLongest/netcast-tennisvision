FROM image.ppinfra.com/prod-ahskpcitxxwcgdnfqfpu/netcast-tennisvision:production-v1

# The frozen production-v1 image already contains CUDA, Python dependencies and
# all model assets.  Release images are intentionally thin code-only overlays so
# an on-demand worker does not have to cold-pull a second full ML runtime.
WORKDIR /app
COPY . .

ENV PYTHONPATH=/app/src

RUN set -eux; \
    if [ ! -d /app/models ]; then \
      ln -s /opt/netcast/models /app/models; \
    fi; \
    test -f /app/models/racketvision_balltrack_state_v1.pt; \
    test -f /app/models/bounce_classifier_production_v1.pkl; \
    test -f /app/models/yolo11n-seg.pt; \
    test -f /app/models/osnet_ain_x1_0_msmt17_256x128_amsgrad_ep50_lr0.0015_coslr_b64_fb10_softmax_labsmth_flip_jitter.pth; \
    python -c "import netcast_tennisvision; import netcast_tennisvision.api.server"

CMD ["python", "-m", "netcast_tennisvision.cloud.worker"]
